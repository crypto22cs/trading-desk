# 复制为 .env 后填写。不要提交 .env，不要把私钥写进配置文件或命令行参数。
# paper 模式不读取私钥。

# 测试网 / 主网真正广播的总开关。未设置或不是 1 时，只构造 EIP-712 计划，不提交。
NADO_LIVE=0

# 主网额外确认。mode=mainnet 时必须同时满足 NADO_LIVE=1 且本值为 YES，否则进程拒绝启动。
# NADO_CONFIRM_MAINNET=YES

# 单钱包私钥：0x 加 64 位十六进制。配置里用 keyEnv: NADO_PRIVATE_KEY 引用。
# NADO_PRIVATE_KEY=

# 第二个钱包可另起变量名，例如 NADO_PRIVATE_KEY_2，再在 YAML 里指向它。
# NADO_PRIVATE_KEY_2=

# HD 助记词（12/24 个英文单词）。配置里用 mnemonicEnv 引用，路径写在 YAML，不写在这里。
# NADO_MNEMONIC=

# 加密私钥文件的口令。配合 `seal` 子命令和 wallets[].keyFile。
# NADO_KEY_PASSPHRASE=

# 仅 `seal` 使用：要加密的私钥。优先用环境变量，不要写进 shell 历史可改用 stdin。
# NADO_KEY_TO_SEAL=
